{
  "name": "@tricord/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch --watch-preserve-output --import tsx --env-file-if-exists=.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/migrate.ts",
    "db:verify-persistence": "tsx --env-file-if-exists=.env src/db/verify-persistence.ts",
    "owner:bootstrap": "tsx --env-file-if-exists=.env src/auth/bootstrap.ts",
    "test:desktop": "tsx --env-file-if-exists=.env src/auth/desktop-smoke.ts",
    "test:desktop:authority": "tsx --env-file-if-exists=.env src/screen/desktop-authority-smoke.ts",
    "test:browser": "tsx --env-file-if-exists=.env src/auth/browser-smoke.ts",
    "test:presence": "tsx --env-file-if-exists=.env src/presence-browser-smoke.ts",
    "test:voice": "tsx --env-file-if-exists=.env src/voice/browser-smoke.ts",
    "test:voice:load": "tsx --env-file-if-exists=.env src/voice/load-smoke.ts",
    "test:voice:check": "tsx --env-file-if-exists=.env src/voice/check-test-services.ts",
    "test:screen": "pnpm build && node dist/screen/feasibility-smoke.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.1",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.10",
    "@livekit/protocol": "^1.53.1",
    "@tricord/shared": "workspace:*",
    "argon2": "^0.45.2",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "livekit-server-sdk": "^2.19.3",
    "pg": "^8.16.0",
    "socket.io": "^4.8.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/pg": "^8.15.0",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.20.0"
  },
  "files": [
    "dist",
    "drizzle"
  ]
}
