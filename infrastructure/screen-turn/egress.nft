table inet rajcord_screen_turn {
  chain output {
    type filter hook output priority -10; policy accept;
    # Relay packets to the shared VPS IP may reach other screen allocations.
    meta skuid 61628 udp sport 52000-52063 fib daddr type local udp dport 52000-52063 accept
    meta skuid 61628 udp sport 52000-52063 fib daddr type local drop
    meta skuid 61628 udp sport 52000-52063 ip daddr { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24, 192.168.0.0/16, 198.18.0.0/15, 198.51.100.0/24, 203.0.113.0/24, 224.0.0.0/3 } drop
    meta skuid 61628 meta nfproto ipv6 drop
  }
}
