user nginx;
worker_processes auto;
pid /var/run/nginx.pid;
# Request URLs can contain opaque voice leases; keep them out of diagnostics.
error_log /dev/null;
events { worker_connections 1024; }
http {
  include /etc/nginx/mime.types;
  server_tokens off;
  access_log off;
  client_max_body_size 16k;
  resolver 127.0.0.11 valid=10s ipv6=off;
  map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
  }
  server {
    listen 80;
    server_name __PUBLIC_IP__;
    location ^~ /.well-known/acme-challenge/ {
      root /var/www/acme;
      try_files $uri =404;
    }
    location / { return 308 https://__PUBLIC_IP__$request_uri; }
  }
  server {
    listen 443 ssl;
    server_name __PUBLIC_IP__;
    ssl_certificate /etc/letsencrypt/live/tricord/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/tricord/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 1d;
    if ($host != '__PUBLIC_IP__') { return 444; }
    location / {
      # Resolve the app again after a container replacement; no stale upstream IP.
      set $tricord_upstream http://app:3001;
      proxy_pass $tricord_upstream;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_set_header Host __PUBLIC_IP__;
      proxy_set_header X-Forwarded-Host __PUBLIC_IP__;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header Forwarded '';
      proxy_set_header CF-Connecting-IP '';
      proxy_read_timeout 75s;
      proxy_send_timeout 75s;
      proxy_buffering off;
    }
  }
}
