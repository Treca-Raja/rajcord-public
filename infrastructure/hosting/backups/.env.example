# Reference only. Fill on the VPS as /etc/tricord/production/restic.env,
# owned by root with mode 600. Never commit the completed file.
# Copy the bucket's S3 endpoint from Cloudflare; jurisdictional buckets use
# a different endpoint. Keep the bucket private and use Standard storage.
RESTIC_REPOSITORY='s3:https://ACCOUNT_ID.r2.cloudflarestorage.com/rajcord-production-backups'
RESTIC_PASSWORD_FILE='/etc/tricord/production/restic-password'
AWS_ACCESS_KEY_ID='REPLACE_WITH_BUCKET_SCOPED_ACCESS_KEY_ID'
AWS_SECRET_ACCESS_KEY='REPLACE_WITH_BUCKET_SCOPED_SECRET_ACCESS_KEY'
AWS_DEFAULT_REGION='auto'
