{
  "name": "tricord",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "setup:desktop": "pnpm --filter @tricord/desktop exec install-electron",
    "dev": "pnpm build:packages && concurrently -k -n api,web \"pnpm --filter @tricord/api dev\" \"pnpm --filter @tricord/web dev\"",
    "dev:desktop": "pnpm build:packages && pnpm --filter @tricord/desktop build && concurrently -k -n api,web,desktop \"pnpm --filter @tricord/api dev\" \"pnpm --filter @tricord/web dev\" \"wait-on http://127.0.0.1:5173 http://127.0.0.1:3001/health && pnpm --filter @tricord/desktop dev\"",
    "build:packages": "pnpm --filter @tricord/shared build && pnpm --filter @tricord/ui build",
    "build": "pnpm -r build",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "db:generate": "pnpm --filter @tricord/api db:generate",
    "db:migrate": "pnpm --filter @tricord/api db:migrate",
    "db:up": "docker compose --env-file infrastructure/.env -f infrastructure/compose.yaml up -d --wait",
    "db:down": "docker compose --env-file infrastructure/.env -f infrastructure/compose.yaml down",
    "db:setup": "node scripts/db-setup.mjs",
    "test:db": "vitest run --config vitest.database.config.ts",
    "db:verify-persistence": "pnpm --filter @tricord/api db:verify-persistence",
    "owner:bootstrap": "pnpm --filter @tricord/api owner:bootstrap",
    "test:desktop": "pnpm build && pnpm --filter @tricord/api test:desktop",
    "test:browser": "pnpm build && pnpm --filter @tricord/api test:browser"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.0.0",
    "globals": "^17.0.0",
    "prettier": "^3.6.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "wait-on": "^9.0.0"
  }
}
